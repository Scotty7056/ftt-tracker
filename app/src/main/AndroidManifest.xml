<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

	<application
		android:allowBackup="true"
		android:icon="@mipmap/ic_launcher"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:label="Freizeitticket Tracker"
		android:supportsRtl="true"
		android:theme="@style/Theme.FreizeitticketTracker">
	
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="DEIN_MAPS_API_KEY" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

		<receiver
			android:name=".widget.FreizeitticketWidget"
			android:exported="true"
			android:label="Freizeitticket Tracker">
			<intent-filter>
				<action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
			</intent-filter>
			<meta-data
			android:name="android.appwidget.provider"
			android:resource="@xml/freizeitticket_widget_info" />
		</receiver>

    </application>
</manifest>